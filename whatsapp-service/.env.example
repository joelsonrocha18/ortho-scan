SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Horario do disparo diario no formato cron. Padrao: 08:00.
CRON_TIME=0 8 * * *
TZ=America/Sao_Paulo

# Use true para testar a rotina assim que o WhatsApp conectar.
RUN_ON_START=false

# Em servidores Linux sem interface grafica, mantenha true.
PUPPETEER_HEADLESS=true

# Painel web online. Use um token forte e secreto.
PORT=3000
ADMIN_TOKEN=troque-por-um-token-grande-e-secreto

# Caminho persistente da sessao do WhatsApp.
AUTH_DATA_PATH=./.wwebjs_auth
