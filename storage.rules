rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function clinicId() {
      return request.auth.token.clinicId;
    }

    function isMaster() {
      return isAuthenticated() && role() == 'master_admin';
    }

    function isInternalUser() {
      return isAuthenticated() && role() in ['master_admin', 'dentist_admin', 'lab_tech', 'receptionist'];
    }

    function isLabTechOrAbove() {
      return isAuthenticated() && role() in ['master_admin', 'dentist_admin', 'lab_tech'];
    }

    function belongsToClinic(pathClinicId) {
      return clinicId() == pathClinicId;
    }

    function isValidScanFile() {
      return request.resource.contentType.matches('model/.*')
        || request.resource.contentType.matches('application/octet-stream')
        || request.resource.contentType == 'application/zip'
        || request.resource.contentType.matches('image/.*');
    }

    function isValidImageFile() {
      return request.resource.contentType.matches('image/.*');
    }

    function isUnder50MB() {
      return (request.resource != null && request.resource.size <= 50 * 1024 * 1024)
        || (resource != null && resource.size <= 50 * 1024 * 1024);
    }

    function isUnder10MB() {
      return (request.resource != null && request.resource.size <= 10 * 1024 * 1024)
        || (resource != null && resource.size <= 10 * 1024 * 1024);
    }

    function isUnder25MB() {
      return request.resource != null && request.resource.size <= 25 * 1024 * 1024;
    }

    function isUnder5MB() {
      return request.resource != null && request.resource.size <= 5 * 1024 * 1024;
    }

    match /clinics/{clinicId}/cases/{caseId}/scans/{filename} {
      allow read: if isAuthenticated() &&
        (isMaster() ||
         (isInternalUser() && belongsToClinic(clinicId)) ||
         (role() in ['dentist_client', 'clinic_client'] && belongsToClinic(clinicId)));

      allow write: if isAuthenticated() &&
        (isMaster() || (role() == 'dentist_admin' && belongsToClinic(clinicId))) &&
        isValidScanFile() &&
        isUnder50MB();

      allow delete: if isMaster();
    }

    match /clinics/{clinicId}/cases/{caseId}/setups3d/{version}/{filename} {
      allow read: if isAuthenticated() &&
        (isMaster() ||
         (isInternalUser() && belongsToClinic(clinicId)) ||
         (role() in ['dentist_client', 'clinic_client'] && belongsToClinic(clinicId)));

      allow write: if isAuthenticated() &&
        (isMaster() || (isLabTechOrAbove() && belongsToClinic(clinicId))) &&
        isValidScanFile() &&
        isUnder50MB();

      allow delete: if isAuthenticated() &&
        (isMaster() || (role() == 'dentist_admin' && belongsToClinic(clinicId)));
    }

    match /clinics/{clinicId}/cases/{caseId}/rx/{filename} {
      allow read: if isAuthenticated() &&
        (isMaster() ||
         (isInternalUser() && belongsToClinic(clinicId)) ||
         (role() in ['dentist_client', 'clinic_client'] && belongsToClinic(clinicId)));

      allow write: if isAuthenticated() &&
        (isMaster() || belongsToClinic(clinicId)) &&
        isValidImageFile() &&
        isUnder10MB();
    }

    match /clinics/{clinicId}/cases/{caseId}/photos/{filename} {
      allow read: if isAuthenticated() &&
        (isMaster() ||
         (isInternalUser() && belongsToClinic(clinicId)) ||
         (role() in ['dentist_client', 'clinic_client'] && belongsToClinic(clinicId)));

      allow write: if isAuthenticated() &&
        (isMaster() || belongsToClinic(clinicId)) &&
        isValidImageFile() &&
        isUnder10MB();
    }

    match /clinics/{clinicId}/patients/{patientId}/docs/{filename} {
      allow read: if isAuthenticated() &&
        (isMaster() || (isInternalUser() && belongsToClinic(clinicId)));

      allow write: if isAuthenticated() &&
        (isMaster() || (isInternalUser() && belongsToClinic(clinicId))) &&
        isUnder10MB();
    }

    match /clinics/{clinicId}/patients/{patientId}/progress-photos/{filename} {
      allow read: if isAuthenticated() &&
        (isMaster() ||
         (isInternalUser() && belongsToClinic(clinicId)) ||
         (role() in ['dentist_client', 'clinic_client'] && belongsToClinic(clinicId)));

      allow write: if isAuthenticated() &&
        (isMaster() || belongsToClinic(clinicId)) &&
        isValidImageFile() &&
        isUnder10MB();
    }

    match /clinics/{clinicId}/patients/{patientId}/selfies/{filename} {
      allow read: if isAuthenticated() &&
        (isMaster() ||
         (isInternalUser() && belongsToClinic(clinicId)) ||
         (role() == 'dentist_client' && request.auth.token.dentistId != null && belongsToClinic(clinicId)) ||
         (role() == 'patient' && request.auth.token.patientId == patientId && belongsToClinic(clinicId)));

      allow write: if isAuthenticated() &&
        role() == 'patient' &&
        request.auth.token.patientId == patientId &&
        belongsToClinic(clinicId) &&
        isValidImageFile() &&
        isUnder5MB();

      allow delete: if isMaster();
    }

    match /clinics/{clinicId}/chat/{roomId}/{filename} {
      allow read: if isAuthenticated() &&
        (isMaster() ||
         belongsToClinic(clinicId) ||
         (role() == 'dentist_client' && request.auth.token.clinicId == clinicId));

      allow write: if isAuthenticated() &&
        (isMaster() || request.auth.token.clinicId == clinicId) &&
        validChatAttachment();

      allow delete: if isMaster();

      function validChatAttachment() {
        let validTypes = request.resource.contentType.matches('image/.*') ||
          request.resource.contentType.matches('audio/.*') ||
          request.resource.contentType.matches('application/pdf') ||
          request.resource.contentType.matches('application/.*') ||
          request.resource.contentType.matches('text/.*');
        return validTypes && isUnder25MB();
      }
    }

    match /tmp/{uid}/{filename} {
      allow read, write: if isAuthenticated() &&
        request.auth.uid == uid &&
        isUnder50MB();
    }
  }
}
