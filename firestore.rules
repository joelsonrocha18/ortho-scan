rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/profiles/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function profileData() {
      return get(profilePath()).data;
    }

    function isActiveProfile() {
      return hasProfile()
        && (!('is_active' in profileData()) || profileData().is_active == true)
        && (!('isActive' in profileData()) || profileData().isActive == true)
        && (!('deleted_at' in profileData()) || profileData().deleted_at == null)
        && (!('deletedAt' in profileData()) || profileData().deletedAt == null);
    }

    function hasAppRole() {
      return isActiveProfile()
        && ('role' in profileData())
        && profileData().role in [
          'master_admin',
          'dentist_admin',
          'dentist_client',
          'clinic_client',
          'lab_tech',
          'receptionist',
        ];
    }

    match /profiles/{userId} {
      allow get: if signedIn() && (userId == request.auth.uid || hasAppRole());
      allow list: if hasAppRole();
      allow create, update, delete: if hasAppRole();
    }

    match /{document=**} {
      allow read, write: if hasAppRole();
    }
  }
}
